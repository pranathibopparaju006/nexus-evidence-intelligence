# Database (Docker Compose requires POSTGRES_PASSWORD; URL below is for local backend runs)
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
DATABASE_URL=postgresql://nexus:nexus@localhost:5432/nexus

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-strong-neo4j-password

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=nexus_content

# Redis
REDIS_URL=redis://localhost:6379

# MinIO object storage (required by Docker Compose)
MINIO_ROOT_USER=nexus
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-password

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6-luna

# Security
SECRET_KEY=change-this-in-production
# Replace this before production; production settings reject this placeholder.
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# App Settings
DEBUG=False
APP_NAME=NEXUS
